# SPDX-License-Identifier: GPL-2.0
#
# Samsung Exynos phones and tablets: the drivers that defconfig builds for
# every Exynos SoC, with the shared ones these devices need early built in.
# ARCH_EXYNOS selects the pin control, MCT timer and PMU drivers.

# Platform
CONFIG_ARCH_EXYNOS=y

# Serial, chip identification and the storage the bootloader leaves configured
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_EXYNOS_CHIPID=y
CONFIG_SCSI_UFS_EXYNOS=y
CONFIG_PHY_SAMSUNG_UFS=y
