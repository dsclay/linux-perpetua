  * Debug marker for the stages after the MMU is on: fill the bootloader's
- * framebuffer and flush the caches so the display sees it.
+ * framebuffer through an uncached mapping. The region is a reserved one, so
+ * remap it first, as the simplefb client does.
  */
 static void exynos_mark(u32 argb)
 {
 	u32 *fb = IOMEM(0xcc000000);
 	unsigned long i;
 
+	remap_range(fb, 1440UL * 2960UL * 4, MAP_UNCACHED);
+
