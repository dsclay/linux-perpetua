diff --git a/arch/arm/boards/samsung-exynos/lowlevel.c b/arch/arm/boards/samsung-exynos/lowlevel.c
index 01148858..62c86356 100644
--- a/arch/arm/boards/samsung-exynos/lowlevel.c
+++ b/arch/arm/boards/samsung-exynos/lowlevel.c
@@ -15,6 +15,21 @@ extern char __dtb_exynos8895_dreamlte_start[];
 extern char __dtb_exynos8895_greatlte_start[];
 extern char __dtb_exynos990_x1s_start[];
 
+/*
+ * Debug marker: fill the bootloader's 1440x2960 framebuffer with one colour.
+ * The MMU is still off here, so the stores reach the display memory.
+ * red: barebox started, yellow: no valid device tree from S-Boot,
+ * blue: model not recognised, green: model matched.
+ */
+static noinline void paint(unsigned int argb)
+{
+	volatile unsigned int *fb = (volatile unsigned int *)0xcc000000UL;
+	unsigned long i;
+
+	for (i = 0; i < 1440UL * 2960UL; i++)
+		fb[i] = argb;
+}
+
 /* called from assembly */
 void lowlevel_exynos(void *downstream_fdt);
 
@@ -64,8 +79,10 @@ static noinline void exynos_continue(void *downstream_fdt)
 		__dtb_start = __dtb_exynos990_x1s_start;
 	} else {
 		/* we didn't match any device */
+		paint(0xff0000ff);
 		return;
 	}
+	paint(0xff00ff00);
 	fdt = __dtb_start + get_runtime_offset();
 	fdt_find_mem(fdt, &membase, &memsize);
 
@@ -74,14 +91,18 @@ static noinline void exynos_continue(void *downstream_fdt)
 
 void lowlevel_exynos(void *downstream_fdt)
 {
+	paint(0xffff0000);
+
 	arm_cpu_lowlevel_init();
 
 	relocate_to_current_adr();
 
 	setup_c();
 
-	if (!downstream_fdt || fdt_check_header(downstream_fdt))
+	if (!downstream_fdt || fdt_check_header(downstream_fdt)) {
+		paint(0xffffff00);
 		return;
+	}
 
 	exynos_continue(downstream_fdt);
 }
