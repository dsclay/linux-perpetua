diff --git a/arch/arm/cpu/uncompress.c b/arch/arm/cpu/uncompress.c
index 210f0c7c..1f16d6fa 100644
--- a/arch/arm/cpu/uncompress.c
+++ b/arch/arm/cpu/uncompress.c
@@ -32,6 +32,23 @@
 extern unsigned char input_data[];
 extern unsigned char input_data_end[];
 
+#ifdef CONFIG_MACH_EXYNOS
+/*
+ * Debug marker for the Samsung Exynos boot: fill the bootloader's framebuffer
+ * with one colour. Outside the first RAM bank the MMU maps it as device memory.
+ */
+static noinline void exynos_pbl_mark(unsigned int argb)
+{
+	volatile unsigned int *fb = (volatile unsigned int *)0xcc000000UL;
+	unsigned long i;
+
+	for (i = 0; i < 1440UL * 2960UL; i++)
+		fb[i] = argb;
+}
+#else
+static inline void exynos_pbl_mark(unsigned int argb) { }
+#endif
+
 static void arm_fill_barebox_layout(struct elf_image *elf,
 				    unsigned long membase, unsigned long memsize)
 {
@@ -112,9 +129,14 @@ void __noreturn barebox_pbl_start(unsigned long membase, unsigned long memsize,
 	print_pbl_mem_layout(membase, endmem, barebox_base);
 #endif
 
+	/* white: the PBL is relocated, the MMU is next */
+	exynos_pbl_mark(0xffffffff);
+
 	/* Enable Caches to speed up the decompression below. */
 	if (IS_ENABLED(CONFIG_MMU)) {
 		mmu_early_enable(membase, memsize);
+		/* purple: the MMU is on */
+		exynos_pbl_mark(0xff8000ff);
 	} else if (IS_ENABLED(CONFIG_ARMV7R_MPU)) {
 		armv7r_cache_enable();
 	} else {
@@ -129,6 +151,9 @@ void __noreturn barebox_pbl_start(unsigned long membase, unsigned long memsize,
 
 	pbl_barebox_uncompress((void*)barebox_base, pg_start, pg_len);
 
+	/* pink: barebox proper is unpacked */
+	exynos_pbl_mark(0xffff80c0);
+
 	pr_debug("relocating ELF in place\n");
 
 	ret = elf_open_binary_into(&elf, (void *)barebox_base);
@@ -166,5 +191,8 @@ void __noreturn barebox_pbl_start(unsigned long membase, unsigned long memsize,
 	if (IS_ENABLED(CONFIG_CPU_V7VE) && boot_cpu_mode() == HYP_MODE)
 		armv7_switch_to_hyp();
 
+	/* brown: the jump into barebox proper is next */
+	exynos_pbl_mark(0xff804000);
+
 	barebox(membase, memsize, handoff_data);
 }
