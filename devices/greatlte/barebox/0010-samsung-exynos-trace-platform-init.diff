+	EXYNOS_STEP(5);
 	if (new_device->id == DEVICE_ID_DYNAMIC) {
 		new_device->id = get_free_deviceid(new_device->name);
 	} else {
@@ -264,6 +266,7 @@ int register_device(struct device *new_device)
 						    new_device->id);
 
 	debug ("register_device: %s\n", dev_name(new_device));
