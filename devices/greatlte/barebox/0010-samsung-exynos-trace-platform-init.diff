diff --git a/include/exynos-debug-mark.h b/include/exynos-debug-mark.h
index 053b8dc3..c515ea23 100644
--- a/include/exynos-debug-mark.h
+++ b/include/exynos-debug-mark.h
@@ -28,9 +28,13 @@ static inline void exynos_mark_all(unsigned int argb)
 		exynos_mark_block(blk, argb);
 }
 
+/* shared by all files, so that every call knows what is on the screen */
+extern unsigned int exynos_mark_prev;
+extern int exynos_trace;
+
 static inline void exynos_mark_index(unsigned int idx)
 {
-	static unsigned int prev = ~0U;
+	unsigned int prev = exynos_mark_prev;
 	unsigned int blk, shift;
 
 	for (blk = 0; blk < 10; blk++) {
@@ -39,9 +43,18 @@ static inline void exynos_mark_index(unsigned int idx)
 			exynos_mark_block(blk, ((idx >> shift) & 1) ?
 					  0xffffffff : 0xff000000);
 	}
-	prev = idx;
+	exynos_mark_prev = idx;
 }
+
+/*
+ * A step inside the initcall that is traced: the number 0x100 + n, so that
+ * the second block from the top is white and the low bits count the steps.
+ */
+#define EXYNOS_STEP(n)	do { if (exynos_trace) exynos_mark_index(0x100 + (n)); } while (0)
+#define EXYNOS_TRACE(on)	do { exynos_trace = (on); } while (0)
 #else
+#define EXYNOS_STEP(n)	do { } while (0)
+#define EXYNOS_TRACE(on)	do { } while (0)
 static inline void exynos_mark_all(unsigned int argb) { }
 static inline void exynos_mark_index(unsigned int idx) { }
 #endif
