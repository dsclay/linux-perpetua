diff --git a/drivers/base/bus.c b/drivers/base/bus.c
index 9e5b43cd..a96c42f5 100644
--- a/drivers/base/bus.c
+++ b/drivers/base/bus.c
@@ -4,6 +4,7 @@
  */
 
 #include <common.h>
+#include <exynos-debug-mark.h>
 #include <linux/device/bus.h>
 #include <driver.h>
 #include <errno.h>
@@ -29,21 +30,25 @@ int bus_register(struct bus_type *bus)
 {
 	int ret;
 
+	EXYNOS_STEP(1);
 	if (get_bus_by_name(bus->name))
 		return -EEXIST;
+	EXYNOS_STEP(2);
 
 	dev_set_name(&bus->dev, "%s", bus->name);
 	bus->dev.id = DEVICE_ID_SINGLE;
+	EXYNOS_STEP(3);
 
 	ret = register_device(&bus->dev);
 	if (ret)
 		return ret;
-
+	EXYNOS_STEP(12);
 
 	INIT_LIST_HEAD(&bus->device_list);
 	INIT_LIST_HEAD(&bus->driver_list);
 
 	class_add_device(&bus_class, &bus->dev);
+	EXYNOS_STEP(13);
 
 	return 0;
 }
