 	of_pinctrl_register_consumer(new_device, new_device->device_node);
+	EXYNOS_STEP(9);
 
 	if (new_device->bus) {
 		if (!new_device->parent)
@@ -288,8 +294,10 @@ int register_device(struct device *new_device)
 		}
 	}
 
+	EXYNOS_STEP(10);
 	if (new_device->parent)
 		list_add_tail(&new_device->sibling, &new_device->parent->children);
+	EXYNOS_STEP(11);
 
