# SPDX-License-Identifier: GPL-2.0
#
# Samsung Galaxy Note 8 (SM-N950N): the first boot has the bootloader's
# framebuffer, the keys and pstore, and nothing else.
CONFIG_BUILTIN_DTB_NAME="exynos/exynos8895-greatlte"

# The simple framebuffer the bootloader leaves is the only display for now.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# Keys, and the rescue initramfs without modules.
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNIX98_PTYS=y

# A freeze leaves no message on a phone with no serial console: keep the
# console and the oops in the ramoops region of the device tree.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
