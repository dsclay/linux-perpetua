diff --git a/include/exynos-debug-mark.h b/include/exynos-debug-mark.h
new file mode 100644
index 00000000..053b8dc3
--- /dev/null
+++ b/include/exynos-debug-mark.h
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Debug markers for the Samsung Exynos boot, drawn into the bootloader's
+ * framebuffer below the stage bands (rows 1968 to 2867): ten blocks of 90 rows
+ * that show a number in binary, the top block the highest bit, white for 1
+ * and black for 0. start_barebox() shows the number of the initcall it is
+ * running, so the last number on the screen names the initcall that stopped.
+ */
+#ifndef EXYNOS_DEBUG_MARK_H
+#define EXYNOS_DEBUG_MARK_H
+
+#ifdef CONFIG_MACH_EXYNOS
+static inline void exynos_mark_block(unsigned int blk, unsigned int argb)
+{
+	volatile unsigned int *p = (volatile unsigned int *)
+		(0xcc000000UL + (1968UL + blk * 90UL) * 1440UL * 4UL);
+	unsigned long i;
+
+	for (i = 0; i < 90UL * 1440UL; i++)
+		p[i] = argb;
+}
+
+static inline void exynos_mark_all(unsigned int argb)
+{
+	unsigned int blk;
+
+	for (blk = 0; blk < 10; blk++)
+		exynos_mark_block(blk, argb);
+}
+
+static inline void exynos_mark_index(unsigned int idx)
+{
+	static unsigned int prev = ~0U;
+	unsigned int blk, shift;
+
+	for (blk = 0; blk < 10; blk++) {
+		shift = 9 - blk;
+		if (prev == ~0U || ((prev >> shift) & 1) != ((idx >> shift) & 1))
+			exynos_mark_block(blk, ((idx >> shift) & 1) ?
+					  0xffffffff : 0xff000000);
+	}
+	prev = idx;
+}
+#else
+static inline void exynos_mark_all(unsigned int argb) { }
+static inline void exynos_mark_index(unsigned int idx) { }
+#endif
+
+#endif
